{
  "name": "@frdy/commands",
  "version": "0.1.0",
  "description": "Commands abstraction for Faraday File Manager",
  "type": "module",
  "exports": {
    ".": {
      "frdy-src": "./src/index.tsx",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "scripts": {
    "dev": "rollup -c -w",
    "build": "rollup -c --silent",
    "lint": "eslint"
  },
  "files": [
    "dist",
    "package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/faraday-fm/faraday.git"
  },
  "keywords": [
    "faraday",
    "web",
    "ui",
    "frontend",
    "file-manager",
    "commands"
  ],
  "author": "Mikhail Isupov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/faraday-fm/faraday/issues"
  },
  "homepage": "https://github.com/faraday-fm/faraday#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@frdy/typescript-config": "workspace:*",
    "@rollup/plugin-alias": "catalog:",
    "@rollup/plugin-commonjs": "catalog:",
    "@rollup/plugin-json": "catalog:",
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-terser": "catalog:",
    "@rollup/pluginutils": "catalog:",
    "@types/parsimmon": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "json5": "catalog:",
    "react": "catalog:",
    "rollup": "catalog:",
    "rollup-plugin-delete": "catalog:",
    "rollup-plugin-dts": "catalog:",
    "rollup-plugin-peer-deps-external": "catalog:",
    "rollup-plugin-string": "catalog:",
    "rollup-plugin-typescript2": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@frdy/eslint-config": "workspace:*",
    "@frdy/sdk": "workspace:*",
    "deepmerge": "catalog:",
    "fast-deep-equal": "catalog:",
    "immer": "catalog:",
    "is-promise": "catalog:",
    "jotai": "catalog:",
    "list": "catalog:",
    "valibot": "catalog:"
  }
}
