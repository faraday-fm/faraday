{
  "name": "@frdy/web-ui",
  "private": false,
  "version": "1.39.0",
  "description": "Web front-end for Faraday file manager",
  "type": "module",
  "exports": {
    ".": {
      "frdy-src": "./src/index.tsx",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "scripts": {
    "dev": "rollup -c -w",
    "build": "rollup -c --silent",
    "test": "echo \"Error: no test specified\" && exit 0",
    "lint": "eslint"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/faraday-fm/web-ui.git"
  },
  "keywords": [
    "faraday",
    "web",
    "ui",
    "frontend",
    "file-manager"
  ],
  "author": "Mikhail Isupov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/faraday-fm/web-ui/issues"
  },
  "homepage": "https://github.com/faraday-fm/web-ui#readme",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@frdy/eslint-config": "workspace:*",
    "@frdy/typescript-config": "workspace:*",
    "@rollup/plugin-alias": "catalog:",
    "@rollup/plugin-commonjs": "catalog:",
    "@rollup/plugin-json": "catalog:",
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-terser": "catalog:",
    "@rollup/plugin-typescript": "catalog:",
    "@rollup/pluginutils": "catalog:",
    "@types/parsimmon": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "react": "catalog:",
    "rollup": "catalog:",
    "rollup-plugin-delete": "catalog:",
    "rollup-plugin-dts": "catalog:",
    "rollup-plugin-peer-deps-external": "catalog:",
    "rollup-plugin-string": "catalog:",
    "rollup-plugin-typescript2": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@frdy/commands": "workspace:*",
    "@frdy/sdk": "workspace:*",
    "@frdy/webview-host": "workspace:*",
    "@xterm/addon-fit": "catalog:",
    "@xterm/addon-unicode11": "catalog:",
    "@xterm/addon-web-links": "catalog:",
    "@xterm/addon-webgl": "catalog:",
    "@xterm/xterm": "catalog:",
    "ansi-colors": "catalog:",
    "comlink": "catalog:",
    "deepmerge": "catalog:",
    "fast-deep-equal": "catalog:",
    "immer": "catalog:",
    "is-promise": "catalog:",
    "jotai": "catalog:",
    "json5": "catalog:",
    "list": "catalog:",
    "parsimmon": "catalog:",
    "usehooks-ts": "catalog:",
    "valibot": "catalog:"
  }
}
