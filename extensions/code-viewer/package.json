{
  "name": "code-viewer",
  "displayName": "Code Viewer",
  "publisher": "faraday",
  "description": "Simple code viewer",
  "author": "Mikhail Isupov",
  "version": "1.4.1",
  "license": "MIT",
  "private": true,
  "categories": [
    "QuickView"
  ],
  "keywords": [
    "quickview",
    "text"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "changeset": "cd ../.. && pnpm changeset"
  },
  "dependencies": {
    "@codemirror/lang-angular": "catalog:",
    "@codemirror/lang-cpp": "catalog:",
    "@codemirror/lang-css": "catalog:",
    "@codemirror/lang-go": "catalog:",
    "@codemirror/lang-html": "catalog:",
    "@codemirror/lang-java": "catalog:",
    "@codemirror/lang-javascript": "catalog:",
    "@codemirror/lang-json": "catalog:",
    "@codemirror/lang-less": "catalog:",
    "@codemirror/lang-lezer": "catalog:",
    "@codemirror/lang-liquid": "catalog:",
    "@codemirror/lang-markdown": "catalog:",
    "@codemirror/lang-php": "catalog:",
    "@codemirror/lang-python": "catalog:",
    "@codemirror/lang-rust": "catalog:",
    "@codemirror/lang-sass": "catalog:",
    "@codemirror/lang-sql": "catalog:",
    "@codemirror/lang-vue": "catalog:",
    "@codemirror/lang-wast": "catalog:",
    "@codemirror/lang-xml": "catalog:",
    "@codemirror/lang-yaml": "catalog:",
    "@codemirror/language": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@frdy/sdk": "workspace:*",
    "codemirror": "catalog:",
    "preact": "catalog:",
    "thememirror": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:"
  },
  "contributes": {
    "quickViews": [
      {
        "id": "code",
        "extensions": [
          ".json",
          ".md",
          ".htm",
          ".html",
          ".js",
          ".jsonc",
          ".json5",
          ".mjs",
          ".cjs",
          ".jsx",
          ".ts",
          ".mts",
          ".tsx",
          ".sql",
          ".css",
          ".go",
          ".cpp",
          ".java",
          ".less",
          ".lezer",
          ".php",
          ".rs",
          ".sass",
          ".vue",
          ".xml",
          ".yml",
          ".yaml"
        ],
        "mimetypes": [
          "text/javascript",
          "application/javascript",
          "application/x-javascript",
          "text/ecmascript",
          "application/ecmascript",
          "application/json",
          "application/x-json",
          "application/manifest+json",
          "application/ld+json",
          "text/typescript",
          "application/typescript",
          "text/jsx",
          "text/typescript-jsx"
        ],
        "path": "./dist/index.js"
      }
    ]
  }
}
