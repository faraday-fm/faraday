{
  "name": "text-viewer",
  "displayName": "Text Viewer",
  "publisher": "faraday",
  "description": "Simple text viewer",
  "author": "Mikhail Isupov",
  "version": "1.2.2",
  "license": "MIT",
  "private": true,
  "categories": [
    "QuickView"
  ],
  "keywords": [
    "quickview",
    "text"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup"
  },
  "dependencies": {
    "@frdy/sdk": "workspace:*",
    "preact": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:"
  },
  "contributes": {
    "quickViews": [
      {
        "id": "text",
        "extensions": [
          ".txt",
          ".map"
        ],
        "path": "./dist/index.mjs"
      }
    ]
  }
}
